# Storage & Directories
STORAGE_DIR=./storage
DATABASE_PATH=./storage/video2mp3.sqlite

# Binary Paths (Leave empty to auto-detect system binary or bundled static fallback)
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Operational Limits
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=10800
MAX_CONCURRENT_JOBS=3
JOB_RETENTION_HOURS=24

# Security & Network
ALLOWED_PROTOCOLS=http,https
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
